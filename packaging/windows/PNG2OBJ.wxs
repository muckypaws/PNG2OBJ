<?xml version="1.0" encoding="UTF-8"?>
<!--
  packaging/windows/PNG2OBJ.wxs
  ===========================================================================
  WiX Toolset v4 authoring for the PNG2OBJ CLI MSI installer.

  Produces an MSI that:
    * installs the Nuitka standalone build into
      "%ProgramFiles%\PNG2OBJ",
    * adds a Start-Menu shortcut,
    * optionally adds the install folder to the per-machine PATH,
    * supports clean major-upgrade and uninstall.

  BUILD (WiX v4 CLI, install with: dotnet tool install wix -g):
    wix build packaging\windows\PNG2OBJ.wxs ^
        -arch x64 ^
        -b PublishDir=build\windows\PNG2ObjV3.dist ^
        -b AssetsDir=packaging\assets ^
        -o dist\PNG2OBJ-3.0.0-x64.msi

  The two `-b <name>=<path>` named bind paths feed the `!(bindpath.*)`
  references below:
    * PublishDir -> the Nuitka standalone *folder* (the "<entry>.dist"
      directory from packaging\build_windows.ps1, NOT the onefile exe). The
      <Files> element harvests every file in it automatically.
    * AssetsDir  -> packaging\assets (holds png2obj.ico for the shortcut and
      Add/Remove-Programs icon).

  WiX v3 note: v3 has no <Files> auto-harvest element and uses light/candle
  with heat.exe to harvest. This file targets v4 (and builds unchanged on
  v5). If you must use v3, harvest with `heat dir` and reference the
  generated ComponentGroup instead of <Files>.
  ===========================================================================
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="PNG2OBJ"
      Manufacturer="muckypaws"
      Version="3.0.0"
      UpgradeCode="1AF7148B-89A0-4FBC-B008-8A85155549A3"
      Scope="perMachine"
      Compressed="yes">

    <!-- Clean upgrades: remove the previous version before installing. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of PNG2OBJ is already installed." />

    <!-- Embed the cab inside the MSI so a single file is distributable. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Human-friendly ARP (Add/Remove Programs) metadata. -->
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/muckypaws/PNG2OBJ" />
    <Icon Id="AppIcon" SourceFile="!(bindpath.AssetsDir)\png2obj.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Install location: %ProgramFiles%\PNG2OBJ (64-bit). -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="PNG2OBJ" />
    </StandardDirectory>

    <!-- Start-Menu folder. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="PNG2OBJ" />
    </StandardDirectory>

    <!-- Harvest the whole Nuitka standalone folder into INSTALLFOLDER. -->
    <ComponentGroup Id="AppPayload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.PublishDir)\**" />
    </ComponentGroup>

    <!-- Start-Menu shortcut to the CLI (opens a console running png2obj). -->
    <DirectoryRef Id="AppShortcutFolder">
      <Component Id="AppShortcut" Guid="FC116EF0-24E1-4818-9E76-6F963CF280C3">
        <Shortcut Id="PNG2OBJStartMenuShortcut"
                  Name="PNG2OBJ"
                  Description="Convert pixel PNG images into 3D OBJ or 2D SVG files"
                  Target="[INSTALLFOLDER]png2obj.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
        <!-- Per-user keypath required for a HKCU-anchored shortcut component. -->
        <RegistryValue Root="HKCU"
                       Key="Software\muckypaws\PNG2OBJ"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Optional: add install dir to the per-machine PATH so `png2obj` works
         from any console. Users can deselect this feature at install time. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppPathEnv" Guid="AE561BAF-07FA-45D9-860E-62770BC16063">
        <Environment Id="UpdatePath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\muckypaws\PNG2OBJ"
                       Name="pathAdded"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Features -->
    <Feature Id="MainApplication" Title="PNG2OBJ (CLI)" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppPayload" />
      <ComponentRef Id="AppShortcut" />
    </Feature>

    <Feature Id="AddToPath"
             Title="Add PNG2OBJ to PATH"
             Description="Lets you run 'png2obj' from any command prompt."
             Level="1">
      <ComponentRef Id="AppPathEnv" />
    </Feature>

    <!--
      GUI EXTENSION POINT (Windows installer):
      When the PySide6/VTK GUI ships, add a second Start-Menu shortcut whose
      Target is the GUI exe, drop WorkingDirectory console semantics, and
      consider an "Advertise" shortcut for Start-Menu search. No change to the
      harvesting above is needed — the GUI files land in the same .dist folder.
    -->
  </Package>
</Wix>
